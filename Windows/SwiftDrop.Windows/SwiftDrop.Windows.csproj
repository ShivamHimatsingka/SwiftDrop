<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>SwiftDrop</AssemblyName>
    <RootNamespace>SwiftDrop.Windows</RootNamespace>
    <ApplicationIcon>SwiftDrop.ico</ApplicationIcon>
    <StartupObject>SwiftDrop.Windows.Program</StartupObject>
    <Version>1.7.1</Version>
    <!-- Single self-contained exe; trimming is off because WPF does not support it. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Lighter: no background GC thread, English resources only. Never compress the single file:
         that unpacks the whole runtime into memory (measured 367 MB vs 94 MB). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SwiftDrop.Core/SwiftDrop.Core.csproj" />
    <Resource Include="SwiftDrop.ico" />
  </ItemGroup>
</Project>
